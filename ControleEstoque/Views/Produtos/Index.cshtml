@model IEnumerable<ControleEstoque.ViewModels.ProdutoEstoqueViewModel>

@{
    ViewData["Title"] = "Index";
}

<h1 class="card-header d-flex justify-content-center py-3">Resumo e Situação Atual do Estoque</h1>
<br />

<p>
<a asp-action="Create" class="btn btn-dark btn-lg col-md-12">Inserir Novo Produto</a>
</p>

<table class="table table-bordered border-black">
    <thead>
        <tr>
            <th>Produto</th>
            <th>Total em Estoque</th>
            <th>Quantidade Mínima</th>
            <th>Status</th>
            <th>Ações</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr class="@(item.Alerta ? "table-danger" : "")">
                <td>@item.Nome</td>
                <td>@item.EstoqueAtual</td>
                <td>@item.QtdEstoqueAlerta</td>

                <td>
                    @if (item.Alerta)
                    {
                        <span class="badge bg-danger">
                            ESTOQUE BAIXO
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-success">
                            OK
                        </span>
                    }
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id"
                       class="btn btn-dark btn-sm">
                        Editar
                    </a>

                    <a asp-action="Details" asp-route-id="@item.Id"
                       class="btn btn-dark btn-sm">
                        Detalhes
                    </a>

                    <a asp-action="Delete" asp-route-id="@item.Id"
                       class="btn btn-danger btn-sm">
                        Excluir
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>
<div class="row mb-4">
    <div class="col-md-12">
        <div class="card border-success shadow-sm">
            <div class="card-body text-center">

                <h5 class="text-success">
                    Valor total de Produtos em estoque:
                </h5>

                <h3>
                    @Model.Sum(x => x.ValorEstoque).ToString("C")
                </h3>

            </div>
        </div>
    </div>
</div>